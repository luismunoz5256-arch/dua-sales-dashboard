# Leave these empty to run in demo mode (data saved only in this browser).
# Fill them in from Supabase > Project Settings > API to use your real hosted database.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Push notifications (step 7). The public key is safe in the app; the rest are server-only (Vercel env vars).
VITE_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=        (Vercel only)
# SUPABASE_SERVICE_ROLE_KEY= (Vercel only)
# CRON_SECRET=              (Vercel only)
